# ── Stage 1: dependency builder ───────────────────────────────────────────────
FROM python:3.11-slim AS builder

WORKDIR /build

# System build deps for scipy/numpy wheels
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential gcc gfortran libopenblas-dev \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
# Install into an isolated prefix so Stage 2 can COPY just the packages
# Install pyproject's core dependencies only (single source of truth, no desktop/test extras)
RUN python -c "import tomllib; print('\\n'.join(tomllib.load(open('pyproject.toml', 'rb'))['project']['dependencies']))" > requirements.txt \
    && pip install --no-cache-dir --prefix=/install -r requirements.txt


# ── Stage 2: runtime image ────────────────────────────────────────────────────
FROM python:3.11-slim

WORKDIR /app

# Copy pre-built packages from Stage 1
COPY --from=builder /install /usr/local

# Copy source — static assets are served by nginx in production, but
# server.main mounts map/static at import time, so the dir must exist here too.
COPY app/     ./app/
COPY server/  ./server/
COPY map/templates/ ./map/templates/
COPY map/static/    ./map/static/

# Non-root user for security; app/logger.py writes to /app/logs
RUN addgroup --system drone && adduser --system --ingroup drone drone \
    && mkdir -p /app/logs && chown drone:drone /app/logs
USER drone

EXPOSE 8000

# Single worker: SimulationRunner is a module-level singleton and is not
# fork-safe — multiple workers would spawn independent simulations causing
# clients to see divergent telemetry depending on which worker serves them.
CMD ["uvicorn", "server.main:app", \
     "--host", "0.0.0.0", "--port", "8000", \
     "--workers", "1", \
     "--log-level", "info"]
