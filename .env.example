# ── Required ──────────────────────────────────────────────────────────────────
# Google Maps JavaScript API key
MAPS_API_KEY=your_google_maps_api_key_here

# ── Optional simulation tuning ────────────────────────────────────────────────
# Number of drones to spawn at startup (default: 6)
N_DRONES=6

# Number of targets to spawn at startup (default: 8)
N_TARGETS=8

# Simulation timestep in seconds (default: 0.05 = 20 Hz)
SIM_DT=0.05

# Communication threshold in metres — drones beyond this range are disconnected (default: 200.0)
CTHR=200.0
